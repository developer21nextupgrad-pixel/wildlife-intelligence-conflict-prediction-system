# WICPS FastAPI Backend Environment Configuration
# Copy to .env for local execution (never commit real credentials).

ENVIRONMENT=development
APP_NAME="WICPS Geospatial Backend API"
API_V1_PREFIX=/api/v1

# PostgreSQL + PostGIS connection string (psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://wicps_user:wicps_dev_password@localhost:5432/wicps

# Strict comma-separated CORS origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=^https://(ais-[a-z0-9-]+\.[a-z0-9.-]+\.run\.app|[a-z0-9-]+\.scf\.usercontent\.goog)$

# Basic API rate limiting (per client IP per rolling window)
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Optional idempotent demo data seeding for development environments
AUTO_SEED_DEMO_DATA=false

# Security safeguard: never expose sensitive animal telemetry GPS coordinates publicly
EXPOSE_TELEMETRY_COORDS=false
