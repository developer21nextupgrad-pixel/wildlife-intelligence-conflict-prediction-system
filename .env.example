API_V1_PREFIX=/api/v1
APP_NAME=WICPS Backend API
AUTO_SEED_DEMO_DATA=false
CORS_ORIGINS=https://your-production-frontend.vercel.app
CORS_ORIGIN_REGEX=
DATABASE_URL=
ENVIRONMENT=production
EXPOSE_TELEMETRY_COORDS=false
RATE_LIMIT_REQUESTS=180
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REDIS_URL=

# Authentication & RBAC (JWT / OIDC)
AUTH_ENABLED=true
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=wicps-api
AUTH_JWT_AUDIENCE=wicps-clients
AUTH_JWT_EXPIRE_MINUTES=480
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=
AUTH_OIDC_JWKS_URL=
AUTH_ROLE_CLAIM=roles
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
AUTH_BOOTSTRAP_ADMIN_NAME=Division Administrator
AUTH_LOGIN_RATE_LIMIT_REQUESTS=12
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# RTSP Security (SSRF Allowlist for explicit remote hostnames/IPs if needed in dev)
RTSP_ALLOWED_HOSTS=

# Frontend & Dev Proxy
VITE_API_BASE_URL=
PORT=3000
FASTAPI_SIDECAR_URL=http://127.0.0.1:8000
WICPS_DISABLE_FASTAPI_SIDECAR=false
WEB_CONCURRENCY=1

# Object Storage (Tigris / S3-compatible)
STORAGE_BACKEND=s3
LOCAL_STORAGE_DIR=backend/storage
S3_ENDPOINT_URL=https://fly.storage.tigris.dev
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=true

# Thermal Ingestion & Processing Bounds
MAX_IMAGE_UPLOAD_MB=25
MAX_VIDEO_UPLOAD_MB=120
DEFAULT_EXTRACT_FPS=5.0
MAX_VIDEO_DURATION_SECONDS=45
MAX_VIDEO_FRAMES=120

# Phase 1 & 2 Wildlife Detection / Re-Identification
SPECIESNET_MODEL=kaggle:google/speciesnet/pyTorch/v4.0.3a/1
SPECIESNET_DEFAULT_COUNTRY=IND
SPECIESNET_DEFAULT_ADMIN1_REGION=
SPECIESNET_GEOFENCE_ENABLED=true
SPECIESNET_MIN_DETECTION_CONFIDENCE=0.25
SPECIESNET_MIN_SPECIES_CONFIDENCE=0.35
SPECIESNET_PRELOAD_ON_STARTUP=true
MEGADESCRIPTOR_ENABLED=true
MEGADESCRIPTOR_MODEL=hf-hub:BVRA/MegaDescriptor-L-384
MEGADESCRIPTOR_EMBEDDING_DIM=768
MEGADESCRIPTOR_PRELOAD_ON_STARTUP=true
REID_MATCH_THRESHOLD=0.80
REID_AMBIGUOUS_THRESHOLD=0.62
REID_MARGIN_THRESHOLD=0.05
REID_MIN_CROP_PX=96
REID_MIN_BLUR_LAPLACIAN=20.0
NOTIFICATION_PROVIDER_MODE=audit_only